# Primary dev is Windows (core.autocrlf=true) but these files run on Linux.
# A CRLF shebang makes the kernel report "bad interpreter" — force LF so a
# Windows checkout can never ship a broken script to the VPS.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
*.sql           text eol=lf
